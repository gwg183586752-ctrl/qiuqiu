{
  "name": "qiuqiu-football-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch-path=src/server --watch-path=src/shared --watch-path=.env src/server/main.ts",
    "start": "node --experimental-strip-types src/server/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:real": "playwright test --config=playwright.real.config.ts",
    "storage:check": "node --experimental-strip-types src/cli/storage-check.ts",
    "storage": "node --experimental-strip-types src/cli/storage.ts",
    "audit": "node --experimental-strip-types src/cli/audit.ts",
    "agent:check": "node --experimental-strip-types src/cli/agent-check.ts",
    "latency:report": "node --experimental-strip-types src/cli/latency-report.ts",
    "persona:check": "node --experimental-strip-types src/cli/persona-check.ts",
    "cloud:check": "node --experimental-strip-types src/cli/cloud-check.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.87",
    "@pixiv/three-vrm": "3.5.5",
    "ai": "6.0.315",
    "better-sqlite3": "12.11.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sqlite-vec": "0.1.9",
    "three": "0.186.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-7.0.2.tgz",
    "vite": "8.3.5"
  }
}
