# 将本文件复制为 .env。云密钥只由后端读取。
CLOUD_MODE=real
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_CHAT_MODEL=mimo-v2.6-flash
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_VOICE=冰糖
# 本机共享入口口令，首次配置时填写自己的值。
ACCESS_TOKEN=change-this-local-token
PORT=3000
BRAIN_MODE=baseline
DATABASE_PATH=data/football.sqlite
AUDIT_PATH=data/turns.jsonl
MAX_RECORDING_SECONDS=30
TURN_TIMEOUT_MS=90000
